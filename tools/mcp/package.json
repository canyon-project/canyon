    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "tsdown": "^0.17.0",
    "vitest": "catalog:"
  }
